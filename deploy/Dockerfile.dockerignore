# Build-context excludes for deploy/Dockerfile (BuildKit per-Dockerfile
# ignore file; BuildKit is the default builder since Docker 23). The build
# context is the repo root (see deploy/docker-compose.yml).
.git
.env
.venv
venv
.pytest_cache
.ruff_cache
**/__pycache__
**/node_modules
.autodev
plans
projects
deploy/.env
deploy/projects
docs/archive
# DS-4 secrets posture: a dev tree's local ui/config.json carries the real
# hooks_token; baking it would embed that secret in a published image. The
# container writes its own ui/config.json on boot.
ui/config.json
