  "plugins": {
    "allow": [
      "anthropic",
      "autodev-pipeline-signals",
      "browser",
      "memory-core",
      "openrouter"
    ],
    "entries": {
      "anthropic": {
        "enabled": true
      },
      "openrouter": {
        "enabled": true
      },
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        },
        "enabled": true
      },
      "autodev-pipeline-signals": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true
        }
      },
      "browser": {
        "enabled": true
      }
    },
    "bundledDiscovery": "compat"
  },
  "mcp": {
    "servers": {
      "playwright": {
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@0.0.40",
          "--headless"
        ]
      }
    }
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "noSandbox": true
  }
}
