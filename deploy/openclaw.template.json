  "agents": {
    "defaults": {
      "model": {
        "primary": "${PLANNER_MODEL}",
        "fallbacks": []
      },
      "models": {
        "openrouter/qwen/qwen3.8-27b": {
          "params": {
            "temperature": 0.6,
            "top_p": 0.95
          }
        },
        "openrouter/z-ai/glm-5.3": {
          "params": {
            "temperature": 0.6,
            "top_p": 0.95
          }
        }
      },
      "skipBootstrap": true,
      "compaction": {
        "mode": "safeguard",
        "postCompactionSections": [
          "Always-Apply: Integration Wiring",
          "Always-Apply: Testing Quality",
          "Always-Apply: Orchestrator Control",
          "Session Startup",
          "Red Lines"
        ]
      },
      "heartbeat": {
        "every": "0m"
      },
      "maxConcurrent": 3,
      "subagents": {
        "maxConcurrent": 1
      }
    },
    "list": [
      {
        "id": "planner",
        "workspace": "~/.openclaw/workspace-planner",
        "model": {
          "primary": "${PLANNER_MODEL}",
          "fallbacks": []
        },
        "tools": {
          "allow": [
            "read",
            "write",
            "exec"
          ]
        },
        "bootstrapMaxChars": 32000,
        "contextLimits": {
          "postCompactionMaxChars": 8000
        }
      },
      {
        "id": "executor",
        "workspace": "~/.openclaw/workspace-executor",
        "model": {
          "primary": "${EXECUTOR_MODEL}",
          "fallbacks": []
        },
        "tools": {
          "allow": [
            "read",
            "write",
            "edit",
            "exec",
            "process",
            "browser"
          ]
        },
        "bootstrapMaxChars": 32000,
        "contextLimits": {
          "postCompactionMaxChars": 8000
        }
      },
      {
        "id": "reviewer",
        "workspace": "~/.openclaw/workspace-reviewer",
        "model": {
          "primary": "${REVIEWER_MODEL}",
          "fallbacks": []
        },
        "tools": {
          "allow": [
            "read",
            "write",
            "exec",
            "process",
            "browser"
          ]
        },
        "bootstrapMaxChars": 32000,
        "contextLimits": {
          "postCompactionMaxChars": 8000
        }
      },
      {
        "id": "prd-creator",
        "workspace": "~/.openclaw/workspace-prd-creator",
        "model": {
          "primary": "${PRD_MODEL}",
          "fallbacks": []
        },
        "tools": {
          "allow": [
            "read",
            "write"
          ],
          "deny": [
            "edit",
            "apply_patch",
            "exec",
            "process",
            "browser"
          ]
        },
        "bootstrapMaxChars": 32000
      },
      {
        "id": "escalation",
        "default": true,
        "workspace": "~/.openclaw/workspace-escalation",
        "model": {
          "primary": "${ESCALATION_MODEL}",
          "fallbacks": []
        },
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "read",
            "write",
            "message"
          ],
          "deny": [
            "edit",
            "apply_patch",
            "exec",
            "process",
            "browser"
          ]
        },
        "bootstrapMaxChars": 32000
      },
      {
        "id": "roadmap-converter",
        "workspace": "~/.openclaw/workspace-roadmap-converter",
        "model": {
          "primary": "${ROADMAP_MODEL}",
          "fallbacks": []
        },
        "tools": {
          "allow": [
            "read",
            "write"
          ],
          "deny": [
            "edit",
            "apply_patch",
            "exec",
            "process",
            "browser"
          ]
        },
        "bootstrapMaxChars": 32000
      }
    ]
  },
  "tools": {
    "profile": "coding",
    "exec": {
      "ask": "on-miss",
      "safeBins": [
        "pytest",
        "python3",
        "pip",
        "git",
        "ruff",
        "cat",
        "grep",
        "find",
        "ls",
        "head",
        "tail",
        "jq",
        "curl",
        "diff",
        "wc",
        "sort",
        "mkdir",
        "cp",
        "mv",
        "rm",
        "touch",
        "chmod",
        "sed",
        "awk",
        "bash",
        "sh"
      ],
      "safeBinProfiles": {
        "awk": {},
        "cat": {},
        "chmod": {},
        "cp": {},
        "curl": {},
        "diff": {},
        "find": {},
        "git": {},
        "grep": {},
        "head": {},
        "jq": {},
        "ls": {},
        "mkdir": {},
        "mv": {},
        "pip": {},
        "pytest": {},
        "rm": {},
        "ruff": {},
        "sed": {},
        "sort": {},
        "tail": {},
        "touch": {},
        "wc": {}
      }
    },
    "loopDetection": {
      "enabled": true,
      "historySize": 30,
      "warningThreshold": 4,
      "criticalThreshold": 6,
      "globalCircuitBreakerThreshold": 8,
      "unknownToolThreshold": 6,
      "detectors": {
        "genericRepeat": true,
        "knownPollNoProgress": true,
        "pingPong": true
      }
    }
  },
  "hooks": {
    "enabled": true,
    "token": "${HOOKS_TOKEN}",
    "defaultSessionKey": "pipeline:default",
    "allowRequestSessionKey": true,
    "allowedSessionKeyPrefixes": [
      "pipeline:",
      "ideas:"
    ],
    "allowedAgentIds": [
      "planner",
      "executor",
      "reviewer",
      "escalation",
      "prd-creator",
      "roadmap-converter"
    ],
    "internal": {
      "enabled": true,
      "entries": {
        "session-memory": {
          "enabled": false
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789"
      ]
    }
  },
