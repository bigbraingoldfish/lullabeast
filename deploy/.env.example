# Lullabeast container environment (deploy/.env).
#
#   cp .env.example .env    then uncomment and fill what you need.
#
# .env is read by docker compose (env_file) and passed into the container.
# It is gitignored; never commit it.

# ── Provider API key (REQUIRED: exactly one of these) ────────────────────────
# The shipped model defaults are OpenRouter models, so OPENROUTER_API_KEY is
# the golden path. With ANTHROPIC_API_KEY instead, also set every *_MODEL
# variable below to Anthropic models (and add pricing entries in the OpenClaw
# config if you want cost reporting; see deploy/README.md).
#OPENROUTER_API_KEY=
#ANTHROPIC_API_KEY=

# ── Per-agent model overrides (optional; defaults shown) ────────────────────
# One knob per agent role. The executor and reviewer models must accept image
# input (the reviewer gate demands screenshot-based visual verification on
# UI/INT phases). Defaults are the audited picks from deploy/CONFIG-AUDIT.md.
#PLANNER_MODEL=openrouter/moonshotai/kimi-k2.7-code
#EXECUTOR_MODEL=openrouter/moonshotai/kimi-k2.7-code
#REVIEWER_MODEL=openrouter/z-ai/glm-5.2
#PRD_MODEL=openrouter/moonshotai/kimi-k2.7-code
#ROADMAP_MODEL=openrouter/z-ai/glm-5.2
#ESCALATION_MODEL=openrouter/qwen/qwen3.6-27b

# ── Dashboard port (optional) ────────────────────────────────────────────────
# Published to the host's loopback only (127.0.0.1:<UI_PORT>).
#UI_PORT=18790

# ── Git identity for pipeline commits (optional) ─────────────────────────────
# The pipeline commits inside your project repos. Defaults: "Lullabeast"
# <lullabeast@container.invalid>.
#GIT_USER_NAME=
#GIT_USER_EMAIL=
