[Unit]
Description=Lullabeast UI Service
After=network.target

[Service]
# EDIT THE PATH BELOW BEFORE INSTALLING - set to your Lullabeast checkout root.
# The module form (-m ui.server) is required and must run from the repo root:
# `python3 ui/server.py` fails with ModuleNotFoundError because the server uses
# package-absolute imports.
WorkingDirectory=/path/to/autodev
ExecStart=/usr/bin/python3 -m ui.server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# Installation steps:
# 1. Copy this file to /etc/systemd/system/autodev-ui.service
# 2. Run: sudo systemctl daemon-reload
# 3. Run: sudo systemctl enable autodev-ui
# 4. Run: sudo systemctl start autodev-ui
