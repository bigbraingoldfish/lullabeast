<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoDev Pipeline</title>
    
    <!-- Google Fonts: JetBrains Mono for headers, IBM Plex Sans for body -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- React and ReactDOM UMD -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    
    <!-- Babel for JSX transformation -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    
    <!-- Tailwind CSS via Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'header': ['"JetBrains Mono"', 'monospace'],
                        'body': ['"IBM Plex Sans"', 'sans-serif'],
                    },
                    colors: {
                        'header-bg': '#1e293b',
                        'panel-bg': '#141618',
                        'accent': '#00b4d8',
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            font-family: 'IBM Plex Sans', sans-serif;
            background-color: #0d0f12;
            color: #e2e8f0;
            margin: 0;
            padding: 0;
            height: 100vh;
            overflow: hidden;
        }
        #app-root {
            height: 100vh;
            overflow: hidden;
        }
        .header-text {
            font-family: 'JetBrains Mono', monospace;
        }
        
        /* Amber pulse animation for RUNNING and WAITING_FOR_SENTINEL states */
        @keyframes amber-pulse {
            0%, 100% {
                background-color: #f59e0b;
                box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7);
            }
            50% {
                background-color: #fbbf24;
                box-shadow: 0 0 0 8px rgba(245, 158, 11, 0);
            }
        }
        
        .status-pulse {
            animation: amber-pulse 2s ease-in-out infinite;
        }

        /* Fade-in animation for new event rows */
        @keyframes fade-in-row {
            0% {
                opacity: 0;
                transform: translateY(-10px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .event-row-fade-in {
            animation: fade-in-row 0.3s ease-out forwards;
        }
        
        /* Event row hover states and transitions */
        .event-row {
            transition: background-color 0.15s ease-in-out;
        }
        .event-row:hover {
            background-color: rgba(51, 65, 85, 0.5);
        }

        /* Assistant message markdown (marked.js output) */
        .msg-md h1, .msg-md h2, .msg-md h3 { color: #e2e8f0; font-weight: 600; margin: 0.5em 0 0.25em; }
        .msg-md h1 { font-size: 1.125rem; }
        .msg-md h2 { font-size: 1.05rem; }
        .msg-md h3 { font-size: 1rem; }
        .msg-md p { margin: 0.35em 0; }
        .msg-md ul, .msg-md ol { margin: 0.35em 0; padding-left: 1.25rem; }
        .msg-md code { background: #0d0f12; color: #67e8f9; padding: 0.1em 0.35em; border-radius: 0.25rem; font-size: 0.85em; }
        .msg-md pre { background: #0d0f12; padding: 0.75rem; border-radius: 0.35rem; overflow-x: auto; margin: 0.5em 0; }
        .msg-md pre code { background: transparent; padding: 0; color: #e2e8f0; }
        .msg-md a { color: #00b4d8; }
    </style>
</head>
<body>
    <div id="app-root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef, createContext, useContext } = React;
        const AppCtx = createContext(null);
        
        // ─── State label and class mappings ───────────────────────────────────────
        const STATE_LABELS = {
            'RUNNING': 'RUNNING',
            'WAITING_FOR_SENTINEL': 'WAITING',
            'WAITING_FOR_HUMAN': 'WAITING FOR HUMAN',
            'HALTED_SILENT': 'HALTED',
            'BLOCKED': 'BLOCKED',
            'COMPLETE': 'COMPLETE',
            'PIPELINE_COMPLETE': 'COMPLETE',
            'STOPPED': 'STOPPED',
        };
        
        const STATE_CLASSES = {
            'RUNNING': 'bg-amber-500 text-slate-900 status-pulse',
            'WAITING_FOR_SENTINEL': 'bg-amber-500 text-slate-900 status-pulse',
            'WAITING_FOR_HUMAN': 'bg-orange-500 text-white',
            'HALTED_SILENT': 'bg-red-600 text-white',
            'BLOCKED': 'bg-red-600 text-white',
            'COMPLETE': 'bg-green-600 text-white',
            'PIPELINE_COMPLETE': 'bg-emerald-700 text-white',
            'STOPPED': 'bg-red-600 text-white',
        };
        
        const AGENT_COLORS = {
            'PLANNER': 'bg-[#1a1d21] text-white',
            'EXECUTOR': 'bg-emerald-600 text-white',
            'REVIEWER': 'bg-[#00b4d8] text-white',
            'ESCALATION': 'bg-amber-600 text-white'
        };

        // ─── Helper functions ─────────────────────────────────────────────────────

        function getGoalForPhase(phaseId, roadmap) {
            if (!phaseId || !roadmap || !Array.isArray(roadmap)) return null;
            const phase = roadmap.find(p => p.id === phaseId);
            return phase ? phase.goal : null;
        }
        
        function getStatusIcon(status) {
            switch (status) {
                case 'complete': return '✓';
                case 'in_progress': return '▶';
                case 'pending': return '○';
                case 'skipped': return '⊘';
                case 'blocked': return '⚠';
                default: return '○';
            }
        }

        function getStatusClasses(status) {
            switch (status) {
                case 'complete': return 'opacity-60 text-slate-400';
                case 'in_progress': return 'border-l-4 border-cyan-500 bg-[#141618]/50';
                case 'blocked': return 'bg-red-900/30 border-l-4 border-red-600';
                case 'skipped': return 'opacity-50 text-slate-500';
                default: return 'text-slate-300';
            }
        }

        function getEventBadgeColor(eventType) {
            switch (eventType) {
                case 'gate_pass': return 'bg-green-600 text-white';
                case 'gate_fail': return 'bg-amber-600 text-white';
                case 'retry': return 'bg-amber-600 text-white';
                case 'escalation_trigger': return 'bg-orange-600 text-white';
                case 'escalation_resolve': return 'bg-blue-600 text-white';
                case 'phase_complete': return 'bg-lime-600 text-white';
                case 'status_changed': return 'bg-slate-600 text-white';
                default: return 'bg-[#1a1d21] text-white';
            }
        }

        /** Format seconds as "Xh Ym" or "Ym" or "—" */
        function formatDuration(seconds) {
            if (seconds === null || seconds === undefined) return '—';
            const s = Math.round(Number(seconds) || 0);
            if (s <= 0) return '—';
            const h = Math.floor(s / 3600);
            const m = Math.floor((s % 3600) / 60);
            if (h > 0) return `${h}h ${m}m`;
            return `${m}m`;
        }

        // ─── Primitive components ─────────────────────────────────────────────────

        function AgentBadge({ agent }) {
            if (!agent) return null;
            const colorClass = AGENT_COLORS[agent] || 'bg-[#1a1d21] text-white';
            return (
                <span className={`header-text px-2 py-0.5 rounded text-xs font-medium ${colorClass}`}>
                    {agent}
                </span>
            );
        }
        
        function DotCounter({ count, label }) {
            const maxDots = 3;
            if (count === undefined || count === null) return null;
            const filled = Math.min(count, maxDots);
            const empty = maxDots - filled;
            return (
                <div className="flex items-center gap-1.5">
                    <span className="text-slate-500 text-xs w-16">{label}</span>
                    <div className="flex gap-1">
                        {Array.from({length: filled}).map((_, i) => (
                            <span key={i} className="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
                        ))}
                        {Array.from({length: empty}).map((_, i) => (
                            <span key={filled + i} className="w-2 h-2 rounded-full bg-[#1a1d21] inline-block"></span>
                        ))}
                    </div>
                </div>
            );
        }

        function LastErrorCode({ errorCode }) {
            if (!errorCode) return null;
            return (
                <span className="font-mono text-xs text-red-400 bg-[#141618] px-1.5 py-0.5 rounded">{errorCode}</span>
            );
        }

        function ElapsedTimer({ lastActionTimestamp, pipeline_status }) {
            const [elapsed, setElapsed] = useState(0);
            useEffect(() => {
                if (!lastActionTimestamp) return;
                const startTime = new Date(lastActionTimestamp).getTime();
                const tick = () => setElapsed(Math.floor((Date.now() - startTime) / 1000));
                tick();
                const interval = setInterval(tick, 1000);
                return () => clearInterval(interval);
            }, [lastActionTimestamp]);
            if (!lastActionTimestamp) return null;
            const isOverdue = pipeline_status === 'WAITING_FOR_SENTINEL' && elapsed > 300;
            const colorClass = isOverdue ? 'text-amber-400' : 'text-slate-400';
            const mins = Math.floor(elapsed / 60);
            const secs = elapsed % 60;
            return (
                <span className={`header-text text-xs ${colorClass}`}>{mins}m {String(secs).padStart(2, '0')}s</span>
            );
        }

        function SkillInjected({ skillInjected, skillAgent }) {
            if (!skillInjected || !skillAgent) return null;
            return (
                <span className="text-slate-500 text-xs">{skillInjected} / {skillAgent}</span>
            );
        }

        // ─── Modals ───────────────────────────────────────────────────────────────

        function ConfirmationModal({ command, onConfirm, onDismiss }) {
            return (
                <div className="fixed inset-0 bg-black/70 flex items-center justify-center z-50">
                    <div className="bg-[#141618] border border-[#1a1d21] rounded-lg p-6 max-w-sm mx-4">
                        <h3 className="header-text text-lg font-semibold text-amber-400 mb-3">
                            Confirm Action
                        </h3>
                        <p className="text-slate-300 mb-6">
                            Are you sure? This cannot be undone.
                        </p>
                        <div className="flex gap-3 justify-end">
                            <button onClick={onDismiss} className="px-4 py-2 rounded bg-[#1a1d21] text-slate-300 hover:bg-[#252830] transition-colors">
                                Cancel
                            </button>
                            <button onClick={onConfirm} className="px-4 py-2 rounded bg-red-600 hover:bg-red-500 text-white font-medium transition-colors">
                                Confirm
                            </button>
                        </div>
                    </div>
                </div>
            );
        }

        function StopConfirmModal({ onConfirm, onDismiss }) {
            return (
                <div className="fixed inset-0 bg-black/70 flex items-center justify-center z-50">
                    <div className="bg-[#141618] border border-[#1a1d21] rounded-lg p-6 max-w-sm mx-4">
                        <h3 className="header-text text-lg font-semibold text-red-400 mb-3">
                            Stop Pipeline?
                        </h3>
                        <p className="text-slate-300 text-sm mb-6">
                            Stop the pipeline? The orchestrator will complete its current agent turn before halting — no new retries will be launched. This may take a few minutes depending on the active agent.
                        </p>
                        <div className="flex gap-3 justify-end">
                            <button onClick={onDismiss} className="px-4 py-2 rounded bg-[#1a1d21] text-slate-300 hover:bg-[#252830] transition-colors">
                                Cancel
                            </button>
                            <button onClick={onConfirm} className="px-4 py-2 rounded bg-orange-600 hover:bg-orange-500 text-white font-medium transition-colors">
                                Stop Pipeline
                            </button>
                        </div>
                    </div>
                </div>
            );
        }

        // ─── EscalationCommandPanel ───────────────────────────────────────────────

        function EscalationCommandPanel({ pipeline_status, escalation_trigger_reason, last_action, escalation_resets }) {
            const [commandSent, setCommandSent] = useState(false);
            const [prevStatus, setPrevStatus] = useState(pipeline_status);
            const [showConfirmModal, setShowConfirmModal] = useState(false);
            const [modalCommand, setModalCommand] = useState(null);

            const isResetDisabled = escalation_resets >= 3;

            useEffect(() => {
                if (prevStatus === 'WAITING_FOR_HUMAN' && pipeline_status !== 'WAITING_FOR_HUMAN') {
                    setCommandSent(false);
                }
                setPrevStatus(pipeline_status);
            }, [pipeline_status, prevStatus]);

            if (pipeline_status !== 'WAITING_FOR_HUMAN') return null;

            const headerText = escalation_trigger_reason || last_action || 'Awaiting human command';

            const handleCommand = (command) => {
                if (command === 'RESET_PHASE' || command === 'SKIP' || command === 'STOP') {
                    setModalCommand(command);
                    setShowConfirmModal(true);
                    return;
                }
                sendCommand(command);
            };

            const sendCommand = async (command) => {
                try {
                    await fetch('/api/command', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ command })
                    });
                    setCommandSent(true);
                } catch (err) {
                    console.log('Failed to send command:', err);
                }
            };

            const modalConfirm = () => {
                if (modalCommand) sendCommand(modalCommand);
                setShowConfirmModal(false);
                setModalCommand(null);
            };

            const modalDismiss = () => {
                setShowConfirmModal(false);
                setModalCommand(null);
            };

            const buttonClass = "header-text px-3 py-2 rounded text-sm font-medium bg-[#1a1d21] hover:bg-[#252830] transition-colors";
            const disabledButtonClass = "header-text px-3 py-2 rounded text-sm font-medium bg-[#1a1d21] opacity-50 cursor-not-allowed";

            const renderButton = (command, label) => {
                const isResetCommand = command === 'RESET_EXECUTION' || command === 'RESET_PHASE';
                if (isResetCommand && isResetDisabled) {
                    return (
                        <button className={disabledButtonClass} disabled={true} title="Reset cap reached (3/3). Use PROCEED or STOP.">
                            {label}
                        </button>
                    );
                }
                return (
                    <button onClick={() => handleCommand(command)} className={buttonClass}>
                        {label}
                    </button>
                );
            };

            return (
                <div className="border-2 border-orange-500 rounded-lg p-4 mt-4 bg-[#141618]/50">
                    <h3 className="header-text text-sm font-semibold text-orange-400 mb-3">
                        {headerText}
                    </h3>
                    {commandSent ? (
                        <div className="text-center py-4">
                            <span className="text-amber-400 text-sm">Command sent — waiting for orchestrator...</span>
                        </div>
                    ) : (
                        <div className="grid grid-cols-2 gap-2">
                            {renderButton('RETRY', 'RETRY')}
                            {renderButton('RESET_EXECUTION', 'RESET EXECUTION')}
                            {renderButton('RESET_PHASE', 'RESET PHASE')}
                            {renderButton('SKIP', 'SKIP')}
                            {renderButton('PROCEED', 'PROCEED')}
                            {renderButton('STOP', 'STOP')}
                        </div>
                    )}
                    {showConfirmModal && (
                        <ConfirmationModal command={modalCommand} onConfirm={modalConfirm} onDismiss={modalDismiss} />
                    )}
                </div>
            );
        }

        // ─── PipelineCompletePanel ────────────────────────────────────────────────

        function PipelineCompletePanel({ roadmap, metricsSummary }) {
            const completeCount = roadmap ? roadmap.filter(p => p.status === 'complete').length : 0;
            const totalCount = roadmap ? roadmap.length : 0;

            return (
                <div className="space-y-4">
                    <div className="flex items-center gap-3">
                        <span className="text-2xl text-emerald-400">✓</span>
                        <div>
                            <h3 className="header-text text-base font-semibold text-emerald-400">Pipeline Complete</h3>
                            <p className="text-slate-400 text-xs">{completeCount} of {totalCount} phases completed</p>
                        </div>
                    </div>

                    {metricsSummary && (
                        <>
                            <div className="grid grid-cols-2 gap-2 pt-1">
                                <div className="bg-[#1a1d21] rounded p-2">
                                    <div className="text-slate-500 text-xs mb-0.5">Phases</div>
                                    <div className="header-text text-lg font-semibold text-slate-200">{metricsSummary.total_phases}</div>
                                </div>
                                <div className="bg-[#1a1d21] rounded p-2">
                                    <div className="text-slate-500 text-xs mb-0.5">Duration</div>
                                    <div className="header-text text-lg font-semibold text-slate-200">{formatDuration(metricsSummary.total_duration_seconds)}</div>
                                </div>
                                <div className="bg-[#1a1d21] rounded p-2">
                                    <div className="text-slate-500 text-xs mb-0.5">Exec Attempts</div>
                                    <div className="header-text text-lg font-semibold text-slate-200">{metricsSummary.total_executor_attempts}</div>
                                </div>
                                <div className="bg-[#1a1d21] rounded p-2">
                                    <div className="text-slate-500 text-xs mb-0.5">Escalations</div>
                                    <div className="header-text text-lg font-semibold text-slate-200">{metricsSummary.total_escalations}</div>
                                </div>
                            </div>

                            {metricsSummary.phases && metricsSummary.phases.length > 0 && (
                                <div>
                                    <div className="text-slate-500 text-xs mb-1 header-text uppercase tracking-wide">Per-phase</div>
                                    <div className="overflow-y-auto max-h-32 border border-[#1a1d21] rounded">
                                        {metricsSummary.phases.map((phase, idx) => (
                                            <div key={idx} className="flex items-center gap-3 px-2 py-1.5 text-xs border-b border-[#1a1d21] last:border-b-0">
                                                <span className="header-text font-semibold text-slate-300 w-14 flex-shrink-0">{phase.phase}</span>
                                                <span className="text-slate-500 w-10 flex-shrink-0">{formatDuration(phase.duration_seconds)}</span>
                                                <span className="text-slate-500">{phase.executor_attempts}x exec</span>
                                                {phase.blame_fires > 0 && (
                                                    <span className="text-amber-600 ml-auto">{phase.blame_fires} blame</span>
                                                )}
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )}
                        </>
                    )}
                </div>
            );
        }

        // ─── StoppedRecoveryPanel ─────────────────────────────────────────────────

        function StoppedRecoveryPanel({ current_phase_raw_id, escalation_resets }) {
            const [sent, setSent] = useState(false);
            const isCapReached = (escalation_resets || 0) >= 3;

            const handleResume = async (command) => {
                try {
                    const rr = await fetch('/api/resume-ready', { method: 'POST' });
                    if (!rr.ok) {
                        console.error('resume-ready failed', await rr.text());
                        return;
                    }
                    await fetch('/api/command', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ command }),
                    });
                    setSent(true);
                    fetch('/api/resume-orchestrator', { method: 'POST' });
                } catch (e) {
                    console.error('Resume flow failed:', e);
                }
            };

            const RESUME_OPTIONS = [
                {
                    command: 'RETRY',
                    label: 'Resume',
                    desc: 'Continue from where it stopped',
                    capped: false,
                },
                {
                    command: 'RESET_EXECUTION',
                    label: 'Reset Execution',
                    desc: 'Keep the plan, retry execution from scratch',
                    capped: true,
                },
                {
                    command: 'RESET_PHASE',
                    label: 'Reset Phase',
                    desc: 'Start the entire phase over from the beginning',
                    capped: true,
                },
            ];

            return (
                <div className="space-y-3">
                    <div className="flex items-center gap-2">
                        <span className="text-red-400 text-lg">◼</span>
                        <div>
                            <h3 className="header-text text-base font-semibold text-red-400">Pipeline Stopped</h3>
                            {current_phase_raw_id && (
                                <p className="text-slate-400 text-xs">Stopped during phase <span className="font-mono text-slate-300">{current_phase_raw_id}</span></p>
                            )}
                        </div>
                    </div>

                    {sent ? (
                        <div className="text-center py-4">
                            <span className="text-amber-400 text-sm">Command sent — restarting orchestrator...</span>
                        </div>
                    ) : (
                        <div className="space-y-2 pt-1">
                            {RESUME_OPTIONS.map(({ command, label, desc, capped }) => {
                                const disabled = capped && isCapReached;
                                return (
                                    <button
                                        key={command}
                                        onClick={() => !disabled && handleResume(command)}
                                        disabled={disabled}
                                        title={disabled ? 'Reset cap reached — use Resume or manually intervene' : undefined}
                                        className={`w-full text-left px-3 py-2.5 rounded border transition-colors ${
                                            disabled
                                                ? 'border-[#1a1d21] bg-[#0f1012] text-slate-600 cursor-not-allowed'
                                                : command === 'RETRY'
                                                    ? 'border-emerald-800 bg-emerald-950/40 hover:bg-emerald-950/70 text-emerald-300'
                                                    : 'border-[#1a1d21] bg-[#1a1d21]/50 hover:bg-[#252830] text-slate-300'
                                        }`}
                                    >
                                        <div className="header-text text-xs font-semibold mb-0.5">{label}</div>
                                        <div className="text-xs text-slate-500">{desc}</div>
                                    </button>
                                );
                            })}
                            {isCapReached && (
                                <p className="text-xs text-amber-600 pt-1">Reset cap reached (3/3) — only Resume is available.</p>
                            )}
                        </div>
                    )}
                </div>
            );
        }

        // ─── CurrentPhasePanel ────────────────────────────────────────────────────

        function CurrentPhasePanel({ current_phase_raw_id, current_agent, roadmap, planner_retries, executor_retries, reviewer_retries, last_error_code, last_action_timestamp, skill_injected, skill_agent, pipeline_status, metricsSummary, escalation_resets }) {
            if (pipeline_status === 'PIPELINE_COMPLETE') {
                return <PipelineCompletePanel roadmap={roadmap} metricsSummary={metricsSummary} />;
            }
            if (pipeline_status === 'STOPPED') {
                return <StoppedRecoveryPanel current_phase_raw_id={current_phase_raw_id} escalation_resets={escalation_resets} />;
            }

            const goal = getGoalForPhase(current_phase_raw_id, roadmap);

            if (!current_phase_raw_id) {
                return (
                    <div className="text-slate-400 italic">No active phase</div>
                );
            }

            return (
                <div className="space-y-3">
                    <div className="flex items-center gap-3">
                        <span className="header-text text-sm font-semibold text-slate-300">{current_phase_raw_id}</span>
                        <AgentBadge agent={current_agent} />
                        <ElapsedTimer lastActionTimestamp={last_action_timestamp} pipeline_status={pipeline_status} />
                    </div>
                    {goal && (
                        <p className="text-slate-400 text-sm leading-relaxed">{goal}</p>
                    )}
                    <div className="space-y-1">
                        <DotCounter count={planner_retries} label="Planner" />
                        <DotCounter count={executor_retries} label="Executor" />
                        <DotCounter count={reviewer_retries} label="Reviewer" />
                    </div>
                    <LastErrorCode errorCode={last_error_code} />
                    <SkillInjected skillInjected={skill_injected} skillAgent={skill_agent} />
                </div>
            );
        }

        // ─── RoadmapPanel ─────────────────────────────────────────────────────────
        // Wrapped in React.memo so it only re-renders when roadmap or metricsSummary
        // props actually change — avoids DOM churn caused by parent pState polling.

        const RoadmapPanel = React.memo(function RoadmapPanel({ roadmap, metricsSummary }) {
            const [expandedPhaseId, setExpandedPhaseId] = useState(null);

            const handlePhaseClick = (phaseId) => {
                setExpandedPhaseId(prev => prev === phaseId ? null : phaseId);
            };

            if (!roadmap || !Array.isArray(roadmap) || roadmap.length === 0) {
                return (
                    <div className="text-slate-500 italic">No roadmap data available</div>
                );
            }

            const totalPhases = roadmap.length;
            const completeCount = roadmap.filter(p => p.status === 'complete').length;
            const percentage = totalPhases > 0 ? Math.round((completeCount / totalPhases) * 100) : 0;

            // Build a lookup map from metrics summary phases array
            const metricsMap = {};
            if (metricsSummary && Array.isArray(metricsSummary.phases)) {
                for (const p of metricsSummary.phases) {
                    if (p.phase) metricsMap[p.phase] = p;
                }
            }

            return (
                <div className="space-y-4 overflow-y-auto max-h-full">
                    {/* Progress bar */}
                    <div className="space-y-1">
                        <div className="flex justify-between text-xs text-slate-400">
                            <span>Progress</span>
                            <span>{completeCount} / {totalPhases} complete</span>
                        </div>
                        <div className="w-full bg-[#1a1d21] rounded-full h-2">
                            <div
                                className="bg-cyan-500 h-2 rounded-full transition-all duration-300"
                                style={{ width: `${percentage}%` }}
                            ></div>
                        </div>
                    </div>

                    {/* Phase list */}
                    <div className="space-y-2">
                        {roadmap.map((phase, index) => {
                            const isExpanded = expandedPhaseId === phase.id;
                            const phaseMeta = metricsMap[phase.id] || null;

                            return (
                                <div
                                    key={phase.id || index}
                                    role="button"
                                    tabIndex={0}
                                    aria-label={`${phase.id}: ${phase.goal || ''}`}
                                    aria-expanded={isExpanded}
                                    className={`p-3 rounded border border-[#1a1d21] cursor-pointer transition-colors ${getStatusClasses(phase.status)} ${isExpanded ? 'bg-[#1a1d21]' : ''}`}
                                    onClick={() => handlePhaseClick(phase.id)}
                                    onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') handlePhaseClick(phase.id); }}
                                >
                                    <div className="flex items-start gap-2">
                                        <span className="text-lg flex-shrink-0">{getStatusIcon(phase.status)}</span>
                                        <div className="flex-1 min-w-0">
                                            <div className="header-text text-sm font-semibold text-slate-300 flex items-center gap-2">
                                                {phase.id}
                                                {isExpanded ? (
                                                    <span className="text-blue-400 text-xs">▼</span>
                                                ) : (
                                                    <span className="text-slate-500 text-xs">▶</span>
                                                )}
                                            </div>
                                            {phase.goal && (
                                                <p className={`text-sm text-slate-400 mt-1 ${isExpanded ? '' : 'truncate'}`}>
                                                    {phase.goal}
                                                </p>
                                            )}
                                            {/* Expanded: exit criteria (all phases) */}
                                            {isExpanded && phase.exit_criteria && phase.exit_criteria.length > 0 && (
                                                <div className="mt-3 pt-2 border-t border-[#1a1d21]">
                                                    <div className="text-xs font-semibold text-slate-400 mb-1">Exit Criteria:</div>
                                                    <ul className="text-xs text-slate-400 space-y-1">
                                                        {phase.exit_criteria.map((criteria, idx) => (
                                                            <li key={idx} className="flex items-start gap-1">
                                                                <span className="text-blue-400">•</span>
                                                                <span>{criteria}</span>
                                                            </li>
                                                        ))}
                                                    </ul>
                                                </div>
                                            )}
                                            {/* Expanded: run metrics for completed phases */}
                                            {isExpanded && phase.status === 'complete' && (
                                                <div className="mt-3 pt-2 border-t border-[#1a1d21]">
                                                    {phaseMeta ? (
                                                        <div>
                                                            <div className="text-xs font-semibold text-slate-400 mb-2">Run Metrics:</div>
                                                            <div className="grid grid-cols-2 gap-x-4 gap-y-1 text-xs">
                                                                <div>
                                                                    <span className="text-slate-500">Duration: </span>
                                                                    <span className="text-slate-300">{formatDuration(phaseMeta.duration_seconds)}</span>
                                                                </div>
                                                                <div>
                                                                    <span className="text-slate-500">Exec attempts: </span>
                                                                    <span className="text-slate-300">{phaseMeta.executor_attempts}</span>
                                                                </div>
                                                                <div>
                                                                    <span className="text-slate-500">Reviewer passes: </span>
                                                                    <span className="text-slate-300">{phaseMeta.reviewer_passes}</span>
                                                                </div>
                                                                <div>
                                                                    <span className="text-slate-500">Blame fires: </span>
                                                                    <span className="text-slate-300">{phaseMeta.blame_fires}</span>
                                                                </div>
                                                                <div>
                                                                    <span className="text-slate-500">Escalations: </span>
                                                                    <span className="text-slate-300">{phaseMeta.escalations}</span>
                                                                </div>
                                                                <div>
                                                                    <span className="text-slate-500">Skill: </span>
                                                                    <span className="text-slate-300">{phaseMeta.skill_used || '—'}</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    ) : (
                                                        <div className="text-xs text-slate-500 italic">No metrics available</div>
                                                    )}
                                                    {/* Git branch reference */}
                                                    <div className="mt-2 pt-2 border-t border-[#1a1d21]">
                                                        <span className="text-slate-500 text-xs">Branch: </span>
                                                        <code className="font-mono text-xs text-cyan-400">phase/{phase.id}</code>
                                                        <span className="text-slate-600 text-xs ml-2">
                                                            restore via: <code className="font-mono text-slate-600">git checkout phase/{phase.id}</code>
                                                        </span>
                                                    </div>
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </div>
            );
        });

        // ─── Activity Feed ────────────────────────────────────────────────────────

        function EventRow({ event, isExpanded, onToggle, isNew }) {
            if (!event) return null;
            
            // Phase 2b fix: server writes "ts", not "timestamp". Support both.
            const ts = event.ts || event.timestamp;
            const timeOnly = ts ? ts.slice(11, 16) : '--:--';
            
            const truncatedDetail = event.detail && event.detail.length > 60
                ? event.detail.slice(0, 60) + '...'
                : event.detail;
            
            const attemptDisplay = event.attempt ?? '—';
            const badgeColor = getEventBadgeColor(event.event_type);
            
            return (
                <div
                    className={"event-row p-2 border-b border-[#1a1d21] cursor-pointer rounded" + (isNew ? " event-row-fade-in" : "")}
                    onClick={onToggle}
                >
                    <div className="flex items-center gap-3">
                        <span className="font-mono text-xs text-slate-400 w-14 flex-shrink-0">
                            {timeOnly}
                        </span>
                        <span className={`px-2 py-0.5 rounded text-xs font-medium ${badgeColor} flex-shrink-0`}>
                            {event.event_type || 'unknown'}
                        </span>
                        <span className="text-xs text-slate-300 w-20 flex-shrink-0 truncate">
                            {event.agent || '—'}
                        </span>
                        <span className="text-xs text-slate-300 w-24 flex-shrink-0 truncate">
                            {event.phase || '—'}
                        </span>
                        <span className="text-xs text-slate-400 w-12 flex-shrink-0 text-center">
                            {attemptDisplay}
                        </span>
                        <span className="text-xs text-slate-400 flex-1 truncate">
                            {truncatedDetail || '—'}
                        </span>
                    </div>
                    {isExpanded && event.detail && (
                        <div className="mt-2 pl-20 text-xs text-slate-300 bg-[#141618] p-2 rounded">
                            {event.detail}
                        </div>
                    )}
                </div>
            );
        }

        function EscalationLogPanel({ events }) {
            function pairEscalations(allEvents) {
                const triggers = allEvents.filter(e => e.event_type === 'escalation_trigger');
                const resolves = allEvents.filter(e => e.event_type === 'escalation_resolve');
                const pairs = [];
                for (const trigger of triggers) {
                    const phase = trigger.phase;
                    const matchingResolve = resolves.find(r =>
                        r.phase === phase &&
                        r.ts && trigger.ts &&
                        new Date(r.ts) > new Date(trigger.ts)
                    );
                    pairs.push({ trigger, resolve: matchingResolve || null, phase });
                }
                return pairs.sort((a, b) => {
                    const aTs = a.trigger.ts || a.trigger.timestamp || '';
                    const bTs = b.trigger.ts || b.trigger.timestamp || '';
                    return bTs.localeCompare(aTs);
                });
            }
            
            const pairedEscalations = pairEscalations(events);
            
            if (!pairedEscalations || pairedEscalations.length === 0) {
                return (
                    <div className="text-slate-500 italic text-sm">No escalations recorded in this session.</div>
                );
            }
            
            function formatTime(ts) {
                if (!ts) return '—';
                const tsStr = ts.ts || ts.timestamp || ts;
                return tsStr.slice(11, 16);
            }
            
            function calculateDuration(triggerTs, resolveTs) {
                if (!triggerTs) return '—';
                const trigger = new Date(triggerTs);
                const resolve = resolveTs ? new Date(resolveTs) : new Date();
                const diffMs = resolve - trigger;
                if (diffMs < 0) return '—';
                const mins = Math.floor(diffMs / 60000);
                const secs = Math.floor((diffMs % 60000) / 1000);
                return `${mins}m ${String(secs).padStart(2, '0')}s`;
            }
            
            return (
                <div className="space-y-2">
                    {pairedEscalations.map((pair, index) => {
                        const trigger = pair.trigger;
                        const resolve = pair.resolve;
                        const isInProgress = !resolve;
                        return (
                            <div key={index} className="p-3 bg-[#141618] rounded border border-[#1a1d21]">
                                <div className="flex items-center gap-3 mb-2">
                                    <span className="header-text text-sm font-semibold text-slate-300">
                                        {pair.phase || '—'}
                                    </span>
                                    {isInProgress ? (
                                        <span className="px-2 py-0.5 rounded text-xs font-medium bg-orange-600 text-white">In Progress</span>
                                    ) : (
                                        <span className="px-2 py-0.5 rounded text-xs font-medium bg-green-600 text-white">Resolved</span>
                                    )}
                                </div>
                                <div className="grid grid-cols-2 gap-2 text-xs">
                                    <div>
                                        <span className="text-slate-500">Triggered:</span>
                                        <span className="font-mono text-slate-300 ml-2">{formatTime(trigger)}</span>
                                    </div>
                                    <div>
                                        <span className="text-slate-500">Reason:</span>
                                        <span className="text-slate-300 ml-2">{trigger.detail || '—'}</span>
                                    </div>
                                    <div>
                                        <span className="text-slate-500">Command:</span>
                                        <span className="text-slate-300 ml-2">
                                            {isInProgress ? 'Awaiting command...' : (resolve.detail || '—')}
                                        </span>
                                    </div>
                                    <div>
                                        <span className="text-slate-500">Resolved:</span>
                                        <span className="font-mono text-slate-300 ml-2">
                                            {isInProgress ? 'Awaiting command...' : formatTime(resolve)}
                                        </span>
                                    </div>
                                    <div className="col-span-2">
                                        <span className="text-slate-500">Duration:</span>
                                        <span className="text-slate-300 ml-2">
                                            {isInProgress ? 'In progress...' : calculateDuration(trigger.ts || trigger.timestamp, resolve.ts || resolve.timestamp)}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>
            );
        }

        function ActivityFeedPanel() {
            const [events, setEvents] = useState([]);
            const [expandedEventId, setExpandedEventId] = useState(null);
            const [newEventIds, setNewEventIds] = useState(new Set());
            const [activityTab, setActivityTab] = useState('activity');
            const eventSourceRef = useRef(null);
            const pollingIntervalRef = useRef(null);
            const isUsingSSE = useRef(true);

            useEffect(() => {
                fetchEvents();
                setupSSE();
                return () => {
                    if (eventSourceRef.current) eventSourceRef.current.close();
                    if (pollingIntervalRef.current) clearInterval(pollingIntervalRef.current);
                };
            }, []);

            function setupSSE() {
                try {
                    const eventSource = new EventSource('/api/events/stream');
                    eventSourceRef.current = eventSource;
                    eventSource.onmessage = (event) => {
                        if (event.type === 'heartbeat' || !event.data || event.data === '{}') return;
                        try {
                            const newEvent = JSON.parse(event.data);
                            const eventTs = newEvent.ts || newEvent.timestamp;
                            if (newEvent && newEvent.id) {
                                setEvents(prevEvents => {
                                    const isDuplicate = prevEvents.some(e => {
                                        const existingTs = e.ts || e.timestamp;
                                        return existingTs && eventTs && existingTs === eventTs;
                                    });
                                    if (isDuplicate) return prevEvents;
                                    setNewEventIds(prev => new Set([...prev, newEvent.id]));
                                    setTimeout(() => {
                                        setNewEventIds(prev => {
                                            const next = new Set(prev);
                                            next.delete(newEvent.id);
                                            return next;
                                        });
                                    }, 350);
                                    return [newEvent, ...prevEvents];
                                });
                            }
                        } catch (e) {
                            console.log('Failed to parse SSE event:', e);
                        }
                    };
                    eventSource.onerror = () => {
                        console.log('SSE connection error, falling back to polling');
                        eventSource.close();
                        isUsingSSE.current = false;
                        startPollingFallback();
                    };
                } catch (err) {
                    console.log('Failed to create EventSource, using polling fallback');
                    startPollingFallback();
                }
            }

            function startPollingFallback() {
                if (pollingIntervalRef.current) return;
                pollingIntervalRef.current = setInterval(() => { fetchEventsPolling(); }, 5000);
                const reconnectInterval = setInterval(() => {
                    if (!isUsingSSE.current) {
                        isUsingSSE.current = true;
                        setupSSE();
                        if (eventSourceRef.current) {
                            clearInterval(pollingIntervalRef.current);
                            pollingIntervalRef.current = null;
                            clearInterval(reconnectInterval);
                        }
                    }
                }, 30000);
            }

            function fetchEvents() {
                fetch('/api/events?limit=30')
                    .then(res => res.json())
                    .then(data => {
                        if (data.events && Array.isArray(data.events)) setEvents(data.events);
                    })
                    .catch(() => {});
            }

            function fetchEventsPolling() {
                fetch('/api/events?limit=30')
                    .then(res => res.json())
                    .then(data => {
                        if (data.events && Array.isArray(data.events)) {
                            setEvents(prevEvents => {
                                const existingTs = new Set(prevEvents.map(e => e.ts || e.timestamp));
                                const newEvents = data.events.filter(e => {
                                    const ts = e.ts || e.timestamp;
                                    if (existingTs.has(ts)) return false;
                                    existingTs.add(ts);
                                    return true;
                                });
                                if (newEvents.length === 0) return prevEvents;
                                newEvents.forEach(e => {
                                    setNewEventIds(prev => new Set([...prev, e.id]));
                                    setTimeout(() => {
                                        setNewEventIds(prev => {
                                            const next = new Set(prev);
                                            next.delete(e.id);
                                            return next;
                                        });
                                    }, 350);
                                });
                                return [...newEvents, ...prevEvents];
                            });
                        }
                    })
                    .catch(() => {});
            }

            function handleRowClick(eventId) {
                setExpandedEventId(prev => prev === eventId ? null : eventId);
            }
            
            const escalationEvents = events.filter(e =>
                e.event_type === 'escalation_trigger' || e.event_type === 'escalation_resolve'
            );

            const TabButton = ({ tab, label }) => (
                <button
                    onClick={() => setActivityTab(tab)}
                    className={`px-3 py-1 rounded text-xs font-medium transition-colors ${
                        activityTab === tab
                            ? 'bg-blue-600 text-white'
                            : 'bg-[#1a1d21] text-slate-300 hover:bg-[#252830]'
                    }`}
                >
                    {label}
                </button>
            );
            
            return (
                <div>
                    <div className="flex gap-2 mb-3">
                        <TabButton tab="activity" label="Activity" />
                        <TabButton tab="escalation" label="Escalation" />
                    </div>
                    <div className="overflow-y-auto max-h-36">
                        {activityTab === 'escalation' ? (
                            <EscalationLogPanel events={escalationEvents} />
                        ) : events.length === 0 ? (
                            <div className="text-slate-500 italic text-sm">No events recorded yet</div>
                        ) : (
                            <div className="space-y-1">
                                {events.map((event, index) => (
                                    <EventRow
                                        key={event.id || index}
                                        event={event}
                                        isExpanded={expandedEventId === event.id}
                                        onToggle={() => handleRowClick(event.id)}
                                        isNew={newEventIds.has(event.id)}
                                    />
                                ))}
                            </div>
                        )}
                    </div>
                </div>
            );
        }

        // ─── Sidebar navigation ───────────────────────────────────────────────────

        function Sidebar({ currentScreen, onNavigate }) {
            const [navCollapsed, setNavCollapsed] = useState(false);
            const navItems = [
                {
                    key: 'pipeline',
                    label: 'Pipeline Monitor',
                    icon: (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" className="w-4 h-4 flex-shrink-0">
                            <rect x="3" y="3" width="7" height="7" rx="1"/>
                            <rect x="14" y="3" width="7" height="7" rx="1"/>
                            <rect x="3" y="14" width="7" height="7" rx="1"/>
                            <rect x="14" y="14" width="7" height="7" rx="1"/>
                        </svg>
                    )
                },
                {
                    key: 'preflight',
                    label: 'Setup & Preflight',
                    icon: (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" className="w-4 h-4 flex-shrink-0">
                            <line x1="4" y1="6" x2="20" y2="6"/>
                            <line x1="8" y1="12" x2="20" y2="12"/>
                            <line x1="12" y1="18" x2="20" y2="18"/>
                            <circle cx="4" cy="6" r="1.5" fill="currentColor" stroke="none"/>
                            <circle cx="7" cy="12" r="1.5" fill="currentColor" stroke="none"/>
                            <circle cx="11" cy="18" r="1.5" fill="currentColor" stroke="none"/>
                        </svg>
                    )
                },
                {
                    key: 'ideas',
                    label: 'Project Ideas',
                    icon: (
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" className="w-4 h-4 flex-shrink-0">
                            <path d="M9 18h6M10 22h4M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17h8v-2.26C17.81 13.47 19 11.38 19 9c0-3.87-3.13-7-7-7z"/>
                        </svg>
                    )
                }
            ];

            return (
                <div
                    className={`${
                        navCollapsed ? "w-12" : "w-44"
                    } flex-shrink-0 bg-[#141618] border-r border-[#1a1d21] flex flex-col transition-[width] duration-200 ease-out`}
                >
                    <div className="px-2 py-4 border-b border-[#1a1d21] flex items-center justify-center gap-1 min-h-[52px]">
                        {!navCollapsed ? (
                            <h1 className="header-text text-base font-bold text-amber-400 tracking-widest flex-1 text-center truncate px-1">
                                AUTODEV
                            </h1>
                        ) : (
                            <span className="header-text text-sm font-bold text-amber-400" title="AUTODEV">
                                A
                            </span>
                        )}
                    </div>
                    <nav className="flex-1 py-2 overflow-y-auto">
                        {navItems.map((item) => {
                            const isActive = currentScreen === item.key;
                            return (
                                <button
                                    key={item.key}
                                    type="button"
                                    title={item.label}
                                    onClick={() => onNavigate(item.key)}
                                    className={`w-full flex items-center gap-2.5 px-3 py-2.5 text-left transition-colors ${
                                        isActive
                                            ? "text-[#00b4d8] bg-[#00b4d8]/10 border-r-2 border-[#00b4d8]"
                                            : "text-slate-400 hover:text-slate-200 hover:bg-[#1a1d21]"
                                    } ${navCollapsed ? "justify-center px-0" : ""}`}
                                >
                                    {item.icon}
                                    {!navCollapsed ? (
                                        <span className="header-text text-xs font-medium leading-tight">{item.label}</span>
                                    ) : null}
                                </button>
                            );
                        })}
                    </nav>
                    <div className="border-t border-[#1a1d21] p-1">
                        <button
                            type="button"
                            onClick={() => setNavCollapsed((c) => !c)}
                            className="w-full py-2 text-xs text-slate-500 hover:text-[#00b4d8] hover:bg-[#1a1d21]/80 rounded header-text"
                            title={navCollapsed ? "Expand menu" : "Collapse menu"}
                        >
                            {navCollapsed ? "»" : "«"}
                        </button>
                    </div>
                </div>
            );
        }


        function handleFileChange(event, ideaId, setUploadError, setUploadSpinner, triggerClarityCheck, setClarityPass, setClarityIssues, setClarityMissing) {
            const f = event.target.files && event.target.files[0];
            if (!f) return;
            if (!f.name.toLowerCase().endsWith(".md")) {
                setUploadError("Only .md files are accepted");
                return;
            }
            setUploadError("");
            setUploadSpinner(true);
            const fd = new FormData();
            fd.append("file", f);
            fetch(`/api/ideas/${ideaId}/upload`, { method: "POST", body: fd })
                .then((r) => r.json())
                .then(() => {
                    setUploadSpinner(false);
                    event.target.value = "";
                    triggerClarityCheck(ideaId, setClarityPass, setClarityIssues, setClarityMissing, setUploadSpinner);
                })
                .catch(() => {
                    setUploadSpinner(false);
                    setUploadError("Upload failed");
                });
        }

        function triggerClarityCheck(ideaId, setClarityPass, setClarityIssues, setClarityMissing, setUploadSpinner) {
            setUploadSpinner(true);
            fetch(`/api/ideas/${ideaId}/clarity-check`, { method: "POST" })
                .then((r) => r.json())
                .then((data) => {
                    setUploadSpinner(false);
                    setClarityPass(data.pass === true ? true : data.pass === false ? false : null);
                    setClarityIssues(data.issues || []);
                    setClarityMissing((data.missing_sections || []).join(", "));
                })
                .catch(() => {
                    setUploadSpinner(false);
                    setClarityPass(false);
                });
        }

        const PRD_SECTION_TITLES = [
            "Problem Statement", "Goals & Success Metrics", "User Stories", "Functional Requirements",
            "Edge Cases", "Non-Functional Requirements", "Dependencies & Integrations", "Milestones & Timeline",
            "Risks & Mitigations", "Open Questions", "Glossary & Domain Terms", "Revision History",
        ];

        function IdeasScreen() {
            const ctx = useContext(AppCtx);
            const [messages, setMessages] = useState([]);
            const [prdContent, setPrdContent] = useState("");
            const [roadmapContent, setRoadmapContent] = useState("");
            const [isLoading, setIsLoading] = useState(false);
            const [convertLoading, setConvertLoading] = useState(false);
            const [convertError, setConvertError] = useState("");
            const [currentIdeaId, setCurrentIdeaId] = useState(null);
            const [ideasList, setIdeasList] = useState([]);
            const [inputText, setInputText] = useState("");
            const [uploadError, setUploadError] = useState("");
            const [uploadSpinner, setUploadSpinner] = useState(false);
            const [clarityPass, setClarityPass] = useState(null);
            const [clarityIssues, setClarityIssues] = useState([]);
            const [clarityMissing, setClarityMissing] = useState("");
            const [readinessStatus, setReadinessStatus] = useState("unavailable");
            const [readinessData, setReadinessData] = useState(null);
            const [readinessSectionsOpen, setReadinessSectionsOpen] = useState(false);
            const [showContinueWarning, setShowContinueWarning] = useState(false);
            const [continueNavPending, setContinueNavPending] = useState(false);
            const [chatsRailCollapsed, setChatsRailCollapsed] = useState(false);
            const taRef = useRef(null);
            const fileRef = useRef(null);
            const readinessPollRef = useRef(null);

            const stopReadinessPoll = () => {
                if (readinessPollRef.current) {
                    clearInterval(readinessPollRef.current);
                    readinessPollRef.current = null;
                }
            };

            const startReadinessPoll = (ideaId) => {
                stopReadinessPoll();
                if (!ideaId) return;
                readinessPollRef.current = setInterval(() => {
                    fetch(`/api/ideas/${ideaId}/readiness/poll`)
                        .then((r) => r.json())
                        .then((p) => {
                            if (p.done) {
                                stopReadinessPoll();
                                fetch(`/api/ideas/${ideaId}/readiness`)
                                    .then((rr) => rr.json())
                                    .then((d) => {
                                        setReadinessStatus(d.status || "unavailable");
                                        setReadinessData(d.data || null);
                                    })
                                    .catch(() => {});
                            }
                        })
                        .catch(() => {});
                }, 3000);
            };

            const refreshIdeas = () => {
                fetch("/api/ideas")
                    .then((r) => r.json())
                    .then((d) => setIdeasList(Array.isArray(d) ? d : []))
                    .catch(() => {});
            };

            useEffect(() => {
                refreshIdeas();
            }, []);

            useEffect(() => {
                if (currentIdeaId === null && ideasList.length > 0) {
                    setCurrentIdeaId(ideasList[0].id);
                }
            }, [ideasList, currentIdeaId]);

            useEffect(() => () => stopReadinessPoll(), []);

            useEffect(() => {
                if (!currentIdeaId) return;
                fetch(`/api/ideas/${currentIdeaId}/session`)
                    .then((r) => r.json())
                    .then((d) => {
                        setMessages(d.messages || []);
                        setPrdContent(d.prd_content || "");
                        setRoadmapContent(d.roadmap_content || "");
                    })
                    .catch(() => {});
                fetch(`/api/ideas/${currentIdeaId}/readiness`)
                    .then((r) => r.json())
                    .then((d) => {
                        setReadinessStatus(d.status || "unavailable");
                        setReadinessData(d.data || null);
                        if (d.status === "updating") startReadinessPoll(currentIdeaId);
                        else stopReadinessPoll();
                    })
                    .catch(() => {
                        setReadinessStatus("unavailable");
                        setReadinessData(null);
                    });
            }, [currentIdeaId]);

            const adjustTa = () => {
                const el = taRef.current;
                if (!el) return;
                el.style.height = "auto";
                const lh = 22;
                const maxH = lh * 5;
                el.style.height = Math.min(el.scrollHeight, maxH) + "px";
            };

            const submitMessage = () => {
                const t = inputText.trim();
                if (!t || isLoading || !currentIdeaId) return;
                const turn = messages.filter((m) => m.role === "user").length + 1;
                setIsLoading(true);
                fetch(`/api/ideas/${currentIdeaId}/message`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ content: t, turn }),
                })
                    .then((r) => {
                        if (!r.ok) throw new Error(String(r.status));
                        return r.json();
                    })
                    .then((data) => {
                        setMessages((prev) => [
                            ...prev,
                            { role: "user", content: t, ts: new Date().toISOString() },
                            { role: "assistant", content: data.response || "", ts: new Date().toISOString() },
                        ]);
                        setPrdContent(data.prd_content || "");
                        setInputText("");
                        setIsLoading(false);
                        setReadinessStatus("updating");
                        setReadinessData(null);
                        startReadinessPoll(currentIdeaId);
                        refreshIdeas();
                    })
                    .catch(() => {
                        setIsLoading(false);
                    });
            };

            const onKeyDown = (e) => {
                if (e.key === "Enter" && !e.shiftKey) {
                    e.preventDefault();
                    submitMessage();
                }
            };

            const newIdea = () => {
                fetch("/api/ideas", { method: "POST" })
                    .then((r) => r.json())
                    .then((d) => {
                        setCurrentIdeaId(d.id);
                        setMessages([]);
                        setPrdContent("");
                        setRoadmapContent("");
                        setInputText("");
                        setClarityPass(null);
                        setChatsRailCollapsed(false);
                    });
            };

            const selectIdeaFromRail = (id) => {
                setCurrentIdeaId(id);
                setChatsRailCollapsed(true);
            };

            const deleteIdea = (id, ev) => {
                ev.stopPropagation();
                if (!confirm("Delete this idea?")) return;
                fetch(`/api/ideas/${id}`, { method: "DELETE" }).then(() => {
                    refreshIdeas();
                    if (currentIdeaId === id) {
                        setMessages([]);
                        setPrdContent("");
                        setCurrentIdeaId(null);
                    }
                });
            };

            const doConvert = () => {
                if (!currentIdeaId || !prdContent.trim()) return;
                setConvertLoading(true);
                setConvertError("");
                fetch(`/api/ideas/${currentIdeaId}/convert`, { method: "POST" })
                    .then((r) => {
                        if (!r.ok) return r.text().then((t) => { throw new Error(t); });
                        return r.json();
                    })
                    .then((d) => {
                        setRoadmapContent(d.roadmap_content || "");
                        setConvertLoading(false);
                    })
                    .catch((e) => {
                        setConvertError(String(e.message || e));
                        setConvertLoading(false);
                    });
            };

            const continueSetup = () => {
                const rm = roadmapContent || "";
                if (rm.includes("Transformation Aborted")) {
                    setShowContinueWarning(true);
                    return;
                }
                setContinueNavPending(true);
                fetch("/api/setup/validate-roadmap", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ content: rm }),
                })
                    .then(async (r) => {
                        const d = await r.json().catch(() => ({}));
                        setContinueNavPending(false);
                        if (!r.ok || !d.valid) {
                            setShowContinueWarning(true);
                            return;
                        }
                        if (ctx && ctx.navigateToPreflightWithSeed) {
                            ctx.navigateToPreflightWithSeed(rm);
                        }
                    })
                    .catch(() => {
                        setContinueNavPending(false);
                        setShowContinueWarning(true);
                    });
            };

            const proceedContinueAnyway = () => {
                setShowContinueWarning(false);
                if (ctx && ctx.navigateToPreflightWithSeed) {
                    ctx.navigateToPreflightWithSeed(roadmapContent || "");
                }
            };

            const listedIds = new Set((ideasList || []).map((it) => it.id));
            const showUnlistedSession = currentIdeaId && !listedIds.has(currentIdeaId);

            return (
                <div className="flex h-full min-w-0">
                    {/* Vertical chat list — collapses after picking a chat so conversation + PRD get space */}
                    <div
                        className={`${
                            chatsRailCollapsed ? "w-11" : "w-56 sm:w-60"
                        } flex-shrink-0 flex flex-col bg-[#0d0f11] border-r border-[#1a1d21] transition-[width] duration-200 ease-out`}
                    >
                        {!chatsRailCollapsed ? (
                            <>
                                <div className="flex-shrink-0 flex items-center justify-between gap-2 px-3 py-2 border-b border-[#1a1d21]">
                                    <span className="header-text text-xs text-slate-400 uppercase tracking-wide">Chats</span>
                                    <button
                                        type="button"
                                        onClick={newIdea}
                                        className="header-text text-xs px-2 py-1 rounded bg-[#1a1d21] text-[#00b4d8] border border-[#1a1d21] hover:border-[#00b4d8]/50"
                                    >
                                        + New
                                    </button>
                                </div>
                                <div className="flex-1 overflow-y-auto py-2 px-2 space-y-1 min-h-0">
                                    {showUnlistedSession ? (
                                        <div className="rounded border border-dashed border-[#2a2d31] bg-[#141618]/50">
                                            <button
                                                type="button"
                                                onClick={() => selectIdeaFromRail(currentIdeaId)}
                                                className={`w-full text-left px-2 py-2 rounded ${
                                                    currentIdeaId && !listedIds.has(currentIdeaId)
                                                        ? "ring-1 ring-[#00b4d8]/40 bg-[#1a1d21]/60"
                                                        : ""
                                                }`}
                                            >
                                                <div className="text-slate-200 truncate text-xs font-medium header-text">Draft</div>
                                                <div className="text-slate-500 truncate text-[11px]">Not listed until first turn completes</div>
                                            </button>
                                        </div>
                                    ) : null}
                                    {ideasList.map((it) => (
                                        <div
                                            key={it.id}
                                            className={`flex rounded border border-transparent overflow-hidden ${
                                                currentIdeaId === it.id ? "border-[#00b4d8]/40 bg-[#1a1d21]" : "hover:bg-[#1a1d21]/70"
                                            }`}
                                        >
                                            <button
                                                type="button"
                                                onClick={() => selectIdeaFromRail(it.id)}
                                                className="flex-1 min-w-0 text-left px-2 py-2"
                                            >
                                                <div className="text-slate-200 truncate text-xs font-medium header-text">{it.name || it.id}</div>
                                                <div className="text-slate-500 truncate text-[11px]">{it.summary || "—"}</div>
                                            </button>
                                            <button
                                                type="button"
                                                className="px-1.5 text-slate-500 hover:text-red-400 hover:bg-[#141618] text-sm shrink-0"
                                                onClick={(e) => deleteIdea(it.id, e)}
                                                aria-label="Delete idea"
                                            >
                                                ×
                                            </button>
                                        </div>
                                    ))}
                                    {ideasList.length === 0 && !showUnlistedSession ? (
                                        <p className="text-slate-600 text-xs italic px-1 py-2">No ideas yet. Click + New.</p>
                                    ) : null}
                                </div>
                            </>
                        ) : (
                            <div className="flex-1 flex flex-col items-center justify-center gap-1 min-h-[120px] px-1">
                                <span className="header-text text-[10px] text-slate-600 [writing-mode:vertical-rl] rotate-180">chats</span>
                            </div>
                        )}
                        <div className="flex-shrink-0 border-t border-[#1a1d21]">
                            <button
                                type="button"
                                onClick={() => setChatsRailCollapsed((c) => !c)}
                                className="w-full py-2.5 text-xs text-slate-500 hover:text-[#00b4d8] hover:bg-[#1a1d21]/60 header-text"
                                title={chatsRailCollapsed ? "Expand chat list" : "Collapse chat list"}
                            >
                                {chatsRailCollapsed ? "▶" : "◀"}
                            </button>
                        </div>
                    </div>

                    <div className="flex-1 flex flex-col min-w-0 bg-[#141618] overflow-hidden border-r border-[#1a1d21]">
                        <div className="flex-shrink-0 border-b border-[#1a1d21] px-3 py-2 flex items-center justify-between gap-2">
                            <span className="header-text text-xs text-slate-500">Conversation</span>
                            <button
                                type="button"
                                disabled={!currentIdeaId}
                                onClick={(e) => deleteIdea(currentIdeaId, e)}
                                className="header-text text-xs px-2 py-1 rounded border border-[#1a1d21] text-slate-400 hover:text-red-400 disabled:opacity-40 disabled:pointer-events-none"
                            >
                                Delete session
                            </button>
                        </div>
                        <div className="flex-1 overflow-y-auto p-4 space-y-2 min-h-0">
                            {!currentIdeaId ? (
                                <p className="text-slate-600 text-xs italic">Select an idea from the list or click + New to start.</p>
                            ) : messages.length === 0 ? (
                                <p className="text-slate-600 text-xs italic">No messages yet — type below to start.</p>
                            ) : null}
                            {messages.map((msg, i) => (
                                <div key={i} className={`flex ${msg.role === "user" ? "justify-end" : "justify-start"}`}>
                                    {msg.role === "user" ? (
                                        <div className="max-w-[95%] rounded px-3 py-2 text-sm bg-[#00b4d8]/20 text-slate-100">
                                            {msg.content}
                                        </div>
                                    ) : (
                                        <div
                                            className="msg-md max-w-[95%] rounded px-3 py-2 text-sm bg-[#1a1d21] text-slate-200"
                                            dangerouslySetInnerHTML={{
                                                __html:
                                                    typeof marked !== "undefined" && marked.parse
                                                        ? marked.parse(msg.content || "", { breaks: true })
                                                        : String(msg.content || "")
                                                              .replace(/&/g, "&amp;")
                                                              .replace(/</g, "&lt;"),
                                            }}
                                        />
                                    )}
                                </div>
                            ))}
                        </div>
                        <div className="flex-shrink-0 border-t border-[#1a1d21] p-3 space-y-2 bg-[#141618]">
                            <input ref={fileRef} type="file" accept=".md" className="hidden" onChange={(e) => handleFileChange(e, currentIdeaId, setUploadError, setUploadSpinner, triggerClarityCheck, setClarityPass, setClarityIssues, setClarityMissing)} />
                            <button type="button" disabled={!currentIdeaId} onClick={() => fileRef.current && fileRef.current.click()} className="header-text w-full text-xs py-1.5 rounded bg-[#1a1d21] text-slate-300 border border-[#1a1d21] hover:border-slate-500 disabled:opacity-40 disabled:pointer-events-none">
                                Upload .md seed
                            </button>
                            {uploadError && <p className="text-red-400 text-xs">{uploadError}</p>}
                            {uploadSpinner && <p className="text-slate-500 text-xs">Working…</p>}
                            <textarea
                                ref={taRef}
                                rows={1}
                                value={inputText}
                                onChange={(e) => { setInputText(e.target.value); adjustTa(); }}
                                onKeyDown={onKeyDown}
                                placeholder="Type a message…"
                                className="w-full bg-[#1a1d21] border border-[#2a2d31] rounded px-3 py-2 text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-slate-500 resize-none max-h-[110px] overflow-y-auto"
                            />
                        </div>
                    </div>
                    <div className="flex-1 flex flex-col min-w-0 bg-[#141618] overflow-hidden">
                        <div className="flex-shrink-0 border-b border-[#1a1d21]">
                            <div className="px-4 py-2 space-y-2">
                                {readinessStatus === "updating" && (
                                    <p className="text-xs text-slate-500 animate-pulse">Updating readiness assessment…</p>
                                )}
                                {readinessStatus === "ready" && readinessData && (
                                    <div className="space-y-2 text-xs border border-[#1a1d21] rounded p-2 bg-[#0d0f11]">
                                        {Array.isArray(readinessData.blocking_gaps) && readinessData.blocking_gaps.length > 0 && (
                                            <div className="rounded border border-amber-700/50 bg-amber-950/30 px-2 py-1.5 text-amber-200">
                                                <span className="font-semibold header-text">Before converting: </span>
                                                {readinessData.blocking_gaps.join(" · ")}
                                            </div>
                                        )}
                                        <div className="flex flex-wrap items-center gap-2">
                                            <span
                                                className={`header-text font-semibold ${
                                                    readinessData.overall_status === "ready"
                                                        ? "text-emerald-400"
                                                        : readinessData.overall_status === "approaching_ready"
                                                          ? "text-amber-400"
                                                          : "text-red-400"
                                                }`}
                                            >
                                                Readiness: {typeof readinessData.score === "number" ? readinessData.score : "—"} / 10
                                            </span>
                                            {readinessData.conversion_confidence && (
                                                <span className="text-[10px] px-1.5 py-0.5 rounded border border-slate-600 text-slate-400">
                                                    Conversion confidence: {readinessData.conversion_confidence}
                                                </span>
                                            )}
                                        </div>
                                        {readinessData.recommendation && (
                                            <p className="text-slate-500 italic">{readinessData.recommendation}</p>
                                        )}
                                        <button
                                            type="button"
                                            className="text-[10px] text-[#00b4d8] hover:underline"
                                            onClick={() => setReadinessSectionsOpen((o) => !o)}
                                        >
                                            {readinessSectionsOpen ? "Hide section details" : "Show section details"}
                                        </button>
                                        {readinessSectionsOpen && readinessData.sections && (
                                            <ul className="list-none space-y-1 pl-0 border-t border-[#1a1d21] pt-2">
                                                {Object.entries(readinessData.sections).map(([secName, info]) => {
                                                    const st = info && info.status;
                                                    const icon = st === "complete" ? "✓" : st === "partial" ? "~" : "✗";
                                                    return (
                                                        <li key={secName} className="flex gap-2 text-slate-400" title={info && info.reason ? info.reason : ""}>
                                                            <span className="shrink-0 w-4">{icon}</span>
                                                            <span className="flex-1">
                                                                <span className="text-slate-300">{secName}</span>
                                                                {info && info.criticality && (
                                                                    <span className="ml-1 text-[10px] text-slate-600">({info.criticality})</span>
                                                                )}
                                                            </span>
                                                        </li>
                                                    );
                                                })}
                                            </ul>
                                        )}
                                    </div>
                                )}
                                <div className="flex flex-wrap gap-2 items-center justify-between">
                                    <div className="flex flex-wrap gap-2 items-center">
                                        {clarityPass === true && <span className="text-xs text-emerald-400 border border-emerald-700 rounded px-2 py-0.5">ready to convert</span>}
                                        {clarityPass === false && <span className="text-xs text-amber-400 border border-amber-700 rounded px-2 py-0.5">needs revision</span>}
                                    </div>
                                    <div className="flex flex-wrap gap-2 justify-end">
                                        {prdContent.trim().length > 0 && currentIdeaId && (
                                            <a href={`/api/ideas/${currentIdeaId}/download`} className="header-text text-xs px-2 py-1 rounded bg-[#1a1d21] text-[#00b4d8] border border-[#1a1d21]">
                                                Download PRD
                                            </a>
                                        )}
                                        <button
                                            type="button"
                                            disabled={!prdContent.trim() || convertLoading}
                                            title={
                                                readinessData &&
                                                readinessData.overall_status &&
                                                readinessData.overall_status !== "ready" &&
                                                typeof readinessData.score === "number"
                                                    ? `Readiness score is ${readinessData.score}/10 — roadmap quality may be low.`
                                                    : undefined
                                            }
                                            onClick={doConvert}
                                            className="header-text text-xs px-2 py-1 rounded bg-[#1a1d21] text-slate-200 border border-[#1a1d21] disabled:opacity-40"
                                        >
                                            {convertLoading ? "Generating…" : "Generate Roadmap"}
                                        </button>
                                        {readinessData &&
                                            readinessData.overall_status &&
                                            readinessData.overall_status !== "ready" &&
                                            typeof readinessData.score === "number" && (
                                                <span className="text-[10px] text-slate-500 max-w-[14rem]">
                                                    Readiness {readinessData.score}/10 — roadmap quality may be low.
                                                </span>
                                            )}
                                        {roadmapContent && currentIdeaId && (
                                            <a href={`/api/ideas/${currentIdeaId}/download-roadmap`} className="header-text text-xs px-2 py-1 rounded bg-[#1a1d21] text-slate-300 border border-[#1a1d21]">
                                                Download Roadmap
                                            </a>
                                        )}
                                        {roadmapContent && (
                                            <button
                                                type="button"
                                                disabled={continueNavPending}
                                                onClick={continueSetup}
                                                className="header-text text-xs px-2 py-1 rounded bg-[#00b4d8]/20 text-[#00b4d8] border border-[#00b4d8]/40 disabled:opacity-40"
                                            >
                                                {continueNavPending ? "Checking…" : "Continue to Setup →"}
                                            </button>
                                        )}
                                    </div>
                                </div>
                            </div>
                        </div>
                        {clarityPass === false && (
                            <div className="px-4 py-2 text-xs text-slate-400 border-b border-[#1a1d21]">
                                {clarityMissing && <div>Missing: {clarityMissing}</div>}
                                <ul className="list-disc pl-4">{clarityIssues.map((x, j) => <li key={j}>{typeof x === "string" ? x : JSON.stringify(x)}</li>)}</ul>
                            </div>
                        )}
                        {convertError && <div className="px-4 py-2 text-xs text-red-400 border-b border-[#1a1d21]">{convertError}</div>}
                        <div className={`flex-1 overflow-y-auto p-4 bg-[#141618] ${isLoading ? "status-pulse opacity-60" : ""}`}>
                            {prdContent.trim() ? (
                                <div className="text-sm text-slate-300 whitespace-pre-wrap mb-6 border-b border-[#1a1d21] pb-4">{prdContent}</div>
                            ) : null}
                            {roadmapContent ? (
                                <div className="border-b border-[#1a1d21] pb-4 mb-4">
                                    <h3 className="header-text text-slate-400 text-sm mb-2">Roadmap draft</h3>
                                    <pre className="text-xs text-slate-400 whitespace-pre-wrap">{roadmapContent}</pre>
                                </div>
                            ) : null}
                            {showContinueWarning && (
                                <div className="mb-4 rounded border border-amber-600/80 bg-amber-950/40 px-3 py-2 text-xs text-amber-100">
                                    <p className="mb-2">
                                        This roadmap did not pass validation or may be unsuitable for the pipeline. You can edit it above or continue with awareness of risk.
                                    </p>
                                    <div className="flex flex-wrap gap-2">
                                        <button
                                            type="button"
                                            onClick={() => setShowContinueWarning(false)}
                                            className="header-text px-2 py-1 rounded bg-[#1a1d21] border border-[#1a1d21] text-slate-200"
                                        >
                                            Review Roadmap
                                        </button>
                                        <button
                                            type="button"
                                            onClick={proceedContinueAnyway}
                                            className="header-text px-2 py-1 rounded bg-amber-900/50 border border-amber-700 text-amber-100"
                                        >
                                            Proceed Anyway
                                        </button>
                                    </div>
                                </div>
                            )}
                            {PRD_SECTION_TITLES.map((title) => (
                                <div key={title} className="mb-4">
                                    <h2 className="text-slate-400 font-semibold text-lg mb-1">{title}</h2>
                                    <p className="text-slate-600 italic text-sm">*Empty — start a conversation to populate this section.*</p>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            );
        }

        function PreflightScreen(props) {
            const {
                seedRoadmap,
                repoPath,
                repoPathLocked,
                roadmapSeed,
                roadmapSeedLocked,
                onRepoPathChange,
                onRepoPathLockToggle,
                onRoadmapSeedChange,
                onRoadmapSeedLockToggle,
                onBack,
                repoPathError,
                roadmapSeedError,
                onRepoPathConfirm,
                onRoadmapSeedConfirm,
                onRunPreflight,
                preflightChecks,
                onLaunch,
                launchError,
                launchDisabled,
            } = props;

            return (
                <div className="flex-1 overflow-y-auto bg-[#0d0f12] p-6">
                    <div className="max-w-2xl mx-auto space-y-6">
                        <h2 className="header-text text-lg text-slate-300">Setup &amp; Preflight</h2>
                        <div className="space-y-2">
                            <label className="text-xs text-slate-500 header-text">Repository path</label>
                            <input
                                type="text"
                                disabled={repoPathLocked}
                                readOnly={repoPathLocked}
                                value={repoPath}
                                onChange={(e) => onRepoPathChange(e.target.value)}
                                placeholder="Enter the full path to your project directory (e.g. /home/pi/projects/my-project)"
                                className={`w-full rounded border border-[#1a1d21] px-3 py-2 text-sm ${repoPathLocked ? "bg-[#0d0f12] text-slate-300" : "bg-[#1a1d21] text-slate-200"}`}
                            />
                            {repoPathError && <p className="text-red-400 text-xs">{repoPathError}</p>}
                            <div className="flex gap-2 items-center">
                                {!repoPathLocked ? (
                                    <button type="button" onClick={onRepoPathConfirm} className="header-text text-sm px-3 py-1 rounded bg-[#00b4d8] text-[#0d0f12] font-medium">
                                        Confirm
                                    </button>
                                ) : (
                                    <>
                                        <span className="text-emerald-500">✓</span>
                                        <button type="button" onClick={onRepoPathLockToggle} className="header-text text-xs text-slate-500 hover:text-slate-300">
                                            Edit
                                        </button>
                                    </>
                                )}
                            </div>
                        </div>
                        <div className="space-y-2">
                            <label className="text-xs text-slate-500 header-text">Roadmap seed</label>
                            {seedRoadmap ? (
                                <p className="text-xs text-[#00b4d8]">From Project Ideas</p>
                            ) : null}
                            {roadmapSeed ? (
                                <textarea
                                    value={roadmapSeed}
                                    onChange={(e) => onRoadmapSeedChange(e.target.value)}
                                    readOnly={roadmapSeedLocked}
                                    disabled={roadmapSeedLocked}
                                    placeholder="Paste roadmap markdown…"
                                    className={`w-full min-h-[120px] rounded border border-[#1a1d21] px-3 py-2 text-sm ${roadmapSeedLocked ? "bg-[#0d0f12] text-slate-300" : "bg-[#1a1d21] text-slate-200"}`}
                                />
                            ) : (
                                <div className="space-y-2">
                                    {!seedRoadmap ? (
                                        <input
                                            type="file"
                                            accept=".md"
                                            onChange={(e) => {
                                                const file = e.target.files && e.target.files[0];
                                                if (!file) return;
                                                const reader = new FileReader();
                                                reader.onload = () => onRoadmapSeedChange(String(reader.result || ""));
                                                reader.readAsText(file);
                                            }}
                                        />
                                    ) : null}
                                    <textarea
                                        value={roadmapSeed}
                                        onChange={(e) => onRoadmapSeedChange(e.target.value)}
                                        placeholder="Paste roadmap markdown…"
                                        className="w-full min-h-[120px] rounded border border-[#1a1d21] px-3 py-2 text-sm bg-[#1a1d21] text-slate-200"
                                    />
                                </div>
                            )}
                            {roadmapSeedError && roadmapSeedError.length > 0 && (
                                <ul className="text-red-400 text-xs space-y-1">
                                    {roadmapSeedError.map((er, i) => (
                                        <li key={i}>Line {er.line}: {er.message}</li>
                                    ))}
                                </ul>
                            )}
                            <div className="flex gap-2 items-center">
                                {!roadmapSeedLocked ? (
                                    <button type="button" onClick={onRoadmapSeedConfirm} className="header-text text-sm px-3 py-1 rounded bg-[#00b4d8] text-[#0d0f12] font-medium">
                                        Confirm
                                    </button>
                                ) : (
                                    <>
                                        <span className="text-emerald-500">✓</span>
                                        <button type="button" onClick={onRoadmapSeedLockToggle} className="header-text text-xs text-slate-500 hover:text-slate-300">
                                            Edit
                                        </button>
                                    </>
                                )}
                            </div>
                        </div>
                        <div className="flex gap-3 flex-wrap">
                            <button type="button" onClick={onRunPreflight} disabled={!repoPathLocked || !roadmapSeedLocked} className="header-text text-sm px-4 py-2 rounded bg-[#1a1d21] text-slate-200 border border-[#1a1d21] disabled:opacity-40">
                                Run Preflight
                            </button>
                            <button type="button" onClick={onLaunch} disabled={launchDisabled} className="header-text text-sm px-4 py-2 rounded bg-[#00b4d8] text-[#0d0f12] font-medium disabled:bg-[#2a2d31] disabled:text-slate-600 disabled:cursor-not-allowed">
                                Launch
                            </button>
                            <button type="button" onClick={onBack} className="header-text text-sm px-4 py-2 rounded border border-[#1a1d21] text-slate-400">
                                Back
                            </button>
                        </div>
                        {launchError && <p className="text-red-400 text-sm whitespace-pre-wrap">{launchError}</p>}
                        {preflightChecks && preflightChecks.length > 0 && (
                            <ul className="space-y-2 text-sm">
                                {preflightChecks.map((c, i) => (
                                    <li key={i} className={`flex gap-2 ${c.status === "fail" ? "text-red-400" : c.status === "warn" ? "text-amber-400" : c.status === "fixed" ? "text-[#00b4d8]" : "text-emerald-400"}`}>
                                        <span className="font-mono text-xs">[{c.status}]</span>
                                        <span>{c.check}: {c.message}</span>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                </div>
            );
        }

        function PipelineScreen() {
            const [pState, setPState] = useState({
                pipeline_status: 'Loading...',
                orchestrator_alive: true,
                current_agent: null,
                project_path: null,
                current_phase_raw_id: '',
                planner_retries: null,
                executor_retries: null,
                reviewer_retries: null,
                last_error_code: null,
                last_action_timestamp: null,
                skill_injected: null,
                skill_agent: null,
                escalation_trigger_reason: null,
                last_action: null,
                escalation_resets: 0,
            });
            const [roadmap, setRoadmap] = useState(null);
            const [metricsSummary, setMetricsSummary] = useState(null);
            const [lastUpdate, setLastUpdate] = useState(null);
            const [showStopModal, setShowStopModal] = useState(false);
            const [stopRequested, setStopRequested] = useState(false);

            useEffect(() => {
                fetchState();
                fetchRoadmap();
                fetchMetricsSummary();
                const stateInterval = setInterval(fetchState, 3000);
                const roadmapInterval = setInterval(fetchRoadmap, 3000);
                return () => {
                    clearInterval(stateInterval);
                    clearInterval(roadmapInterval);
                };
            }, []);

            // Clear stop-requested indicator once pipeline leaves stoppable state
            useEffect(() => {
                const stoppable = ['RUNNING', 'WAITING_FOR_SENTINEL'];
                if (!stoppable.includes(pState.pipeline_status)) {
                    setStopRequested(false);
                }
            }, [pState.pipeline_status]);

            function fetchState() {
                fetch('/api/state')
                    .then(res => res.json())
                    .then(data => {
                        setPState(prev => ({ ...prev, ...data }));
                        setLastUpdate(new Date().toLocaleTimeString());
                    })
                    .catch(() => {});
            }

            function fetchRoadmap() {
                fetch('/api/roadmap')
                    .then(res => res.json())
                    .then(data => {
                        // Only update if data actually changed to avoid unnecessary re-renders
                        setRoadmap(prev => {
                            return JSON.stringify(prev) === JSON.stringify(data) ? prev : data;
                        });
                    })
                    .catch(() => {});
            }

            function fetchMetricsSummary() {
                fetch('/api/metrics-summary')
                    .then(res => res.json())
                    .then(data => { setMetricsSummary(data); })
                    .catch(() => {});
            }

            const handleStopConfirm = async () => {
                setShowStopModal(false);
                try {
                    await fetch('/api/stop', { method: 'POST' });
                    setStopRequested(true);
                } catch (e) {
                    console.log('Stop request failed:', e);
                }
            };

            const handleRefresh = () => {
                fetchState();
                fetchRoadmap();
                fetchMetricsSummary();
            };

            const status = pState.pipeline_status;
            const alive = pState.orchestrator_alive;
            const showStopButton = ['RUNNING', 'WAITING_FOR_SENTINEL'].includes(status);

            // Derive header status label and class
            let statusLabel = '--';
            let statusClass = 'bg-[#1a1d21] text-slate-300';
            if (!alive && (status === 'RUNNING' || status === 'WAITING_FOR_SENTINEL')) {
                statusLabel = 'ORCHESTRATOR DOWN';
                statusClass = 'bg-red-600 text-white';
            } else if (status in STATE_LABELS) {
                statusLabel = STATE_LABELS[status];
                if (status === 'WAITING_FOR_SENTINEL' && pState.current_agent) {
                    statusLabel = `WAITING — ${pState.current_agent}`;
                }
                statusClass = STATE_CLASSES[status] || 'bg-[#1a1d21] text-slate-300';
            }

            const segments = (pState.project_path || '').split('/').filter(s => s);
            const projectDisplay = segments.slice(-2).join('/') || '--/--';

            return (
                <div className="grid grid-rows-[auto_1fr_auto_auto] h-full overflow-hidden">
                    {/* Header bar */}
                    <header className="bg-[#141618] border-b border-[#1a1d21] px-6 py-4">
                        <div className="flex items-center justify-between">
                            <div className="flex items-center gap-6">
                                <span className="header-text text-sm text-slate-500 font-mono">{projectDisplay}</span>
                            </div>
                            <div className="flex items-center gap-3">
                                {showStopButton && !stopRequested && (
                                    <button
                                        onClick={() => setShowStopModal(true)}
                                        className="header-text px-3 py-1 text-xs bg-red-950 hover:bg-red-900 text-red-400 rounded border border-red-800 transition-colors"
                                    >
                                        Stop Pipeline
                                    </button>
                                )}
                                {showStopButton && stopRequested && (
                                    <button
                                        disabled
                                        className="header-text px-3 py-1 text-xs bg-red-950 text-red-400 rounded border border-red-800 opacity-70 status-pulse cursor-not-allowed"
                                    >
                                        Stopping...
                                    </button>
                                )}
                                <span className={`w-2.5 h-2.5 rounded-full flex-shrink-0 ${alive ? 'bg-green-500' : 'bg-red-600'}`}></span>
                                <span className={`header-text px-3 py-1 rounded-full text-sm font-medium ${statusClass}`}>
                                    {statusLabel}
                                </span>
                            </div>
                        </div>
                    </header>

                    {/* Middle section: two-panel grid (Phase 2a: 32/68 split) */}
                    <main className="grid grid-cols-1 md:grid-cols-[32%_68%] gap-4 p-4 overflow-hidden">
                        {/* Left: Current Phase */}
                        <div className="bg-[#141618] rounded-lg border border-[#1a1d21] p-4 overflow-auto">
                            <h2 className="header-text text-lg font-semibold text-slate-300 mb-4">Current Phase</h2>
                            <CurrentPhasePanel
                                current_phase_raw_id={pState.current_phase_raw_id}
                                current_agent={pState.current_agent}
                                roadmap={roadmap}
                                planner_retries={pState.planner_retries}
                                executor_retries={pState.executor_retries}
                                reviewer_retries={pState.reviewer_retries}
                                last_error_code={pState.last_error_code}
                                last_action_timestamp={pState.last_action_timestamp}
                                skill_injected={pState.skill_injected}
                                skill_agent={pState.skill_agent}
                                pipeline_status={status}
                                metricsSummary={metricsSummary}
                                escalation_resets={pState.escalation_resets || 0}
                            />
                            <EscalationCommandPanel
                                pipeline_status={status}
                                escalation_trigger_reason={pState.escalation_trigger_reason}
                                last_action={pState.last_action}
                                escalation_resets={pState.escalation_resets || 0}
                            />
                        </div>

                        {/* Right: Roadmap */}
                        <div className="right-panel bg-[#141618] rounded-lg border border-[#1a1d21] p-4 overflow-auto">
                            <h2 className="header-text text-lg font-semibold text-slate-300 mb-4">Roadmap</h2>
                            <RoadmapPanel roadmap={roadmap} metricsSummary={metricsSummary} />
                        </div>
                    </main>

                    {/* Activity Feed */}
                    <div className="bg-[#141618] border-t border-[#1a1d21] px-4 pt-3 pb-2 overflow-hidden">
                        <h2 className="header-text text-sm font-semibold text-slate-400 mb-2">Activity Feed</h2>
                        <ActivityFeedPanel />
                    </div>

                    {/* Footer */}
                    <footer className="bg-[#141618] border-t border-[#1a1d21] px-6 py-3">
                        <div className="flex items-center justify-between">
                            <span className="header-text text-sm text-slate-500">Pipeline Executor v1.0</span>
                            <div className="flex gap-4 items-center">
                                <button
                                    onClick={handleRefresh}
                                    className="header-text px-3 py-1 text-sm bg-[#1a1d21] hover:bg-[#252830] rounded transition-colors"
                                >
                                    Refresh
                                </button>
                                <span className="header-text text-sm text-slate-500">
                                    Last update: {lastUpdate || '--'}
                                </span>
                            </div>
                        </div>
                    </footer>

                    {/* Stop confirmation modal */}
                    {showStopModal && (
                        <StopConfirmModal
                            onConfirm={handleStopConfirm}
                            onDismiss={() => setShowStopModal(false)}
                        />
                    )}
                </div>
            );
        }

        // ─── Root App with routing ────────────────────────────────────────────────

        function App() {
            const [currentScreen, setCurrentScreen] = useState("pipeline");
            const [seedRoadmap, setSeedRoadmap] = useState("");
            const [repoPath, setRepoPath] = useState("");
            const [repoPathLocked, setRepoPathLocked] = useState(false);
            const [roadmapSeed, setRoadmapSeed] = useState("");
            const [roadmapSeedLocked, setRoadmapSeedLocked] = useState(false);
            const [repoPathError, setRepoPathError] = useState("");
            const [roadmapSeedError, setRoadmapSeedError] = useState([]);
            const [preflightChecks, setPreflightChecks] = useState(null);
            const [launchError, setLaunchError] = useState("");
            const [launchLoading, setLaunchLoading] = useState(false);

            const navigateToPreflightWithSeed = (content) => {
                const text = content || "";
                setSeedRoadmap(text);
                setRoadmapSeed(text);
                setRoadmapSeedLocked(!!text.trim());
                setCurrentScreen("preflight");
            };

            const handleNavigate = (screen) => {
                if (screen === "preflight") {
                    setSeedRoadmap("");
                    setRoadmapSeed("");
                    setRoadmapSeedLocked(false);
                    setRepoPathError("");
                    setRoadmapSeedError([]);
                    setPreflightChecks(null);
                    setLaunchError("");
                }
                setCurrentScreen(screen);
            };

            const onRepoPathConfirm = () => {
                setRepoPathError("");
                const path = (repoPath || "").trim();
                fetch("/api/setup/validate-repo-path", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ path }),
                })
                    .then(async (r) => {
                        const d = await r.json().catch(() => ({}));
                        if (!r.ok) {
                            const detail = d.detail;
                            const msg = Array.isArray(detail)
                                ? detail.map((x) => x.msg || JSON.stringify(x)).join("; ")
                                : detail || d.message || `Request failed (${r.status})`;
                            setRepoPathError(String(msg));
                            return;
                        }
                        if (d.valid) {
                            setRepoPathLocked(true);
                            setRepoPath(path);
                        } else {
                            setRepoPathError(d.error || "Path validation failed");
                        }
                    })
                    .catch((e) => setRepoPathError(String(e.message || "Request failed")));
            };

            const onRoadmapSeedConfirm = () => {
                setRoadmapSeedError([]);
                fetch("/api/setup/validate-roadmap", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ content: roadmapSeed }),
                })
                    .then(async (r) => {
                        const d = await r.json().catch(() => ({}));
                        if (!r.ok) {
                            const detail = d.detail;
                            const msg = Array.isArray(detail)
                                ? detail.map((x) => x.msg || JSON.stringify(x)).join("; ")
                                : detail || d.message || `Request failed (${r.status})`;
                            setRoadmapSeedError([{ line: 0, message: String(msg) }]);
                            return;
                        }
                        if (d.valid) setRoadmapSeedLocked(true);
                        else setRoadmapSeedError(d.errors || []);
                    })
                    .catch(() => setRoadmapSeedError([{ line: 0, message: "Request failed" }]));
            };

            const onRunPreflight = () => {
                setPreflightChecks(null);
                fetch("/api/setup/preflight", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ repo_path: (repoPath || "").trim() }),
                })
                    .then(async (r) => {
                        const d = await r.json().catch(() => ({}));
                        if (!r.ok) {
                            const detail = d.detail;
                            const msg = Array.isArray(detail)
                                ? detail.map((x) => x.msg || JSON.stringify(x)).join("; ")
                                : detail || d.message || `Request failed (${r.status})`;
                            setPreflightChecks([
                                { check: "preflight", status: "fail", message: String(msg) },
                            ]);
                            return;
                        }
                        setPreflightChecks(d.checks || []);
                    })
                    .catch(() =>
                        setPreflightChecks([
                            { check: "preflight", status: "fail", message: "Request failed" },
                        ])
                    );
            };

            const hasFail = preflightChecks && preflightChecks.some((c) => c.status === "fail");
            const launchDisabled =
                !repoPathLocked || !roadmapSeedLocked || !preflightChecks || hasFail || launchLoading;

            const onLaunch = () => {
                setLaunchError("");
                setLaunchLoading(true);
                fetch("/api/setup/launch", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ repo_path: repoPath, roadmap_seed: roadmapSeed }),
                })
                    .then((r) => r.json())
                    .then((d) => {
                        setLaunchLoading(false);
                        if (d.ok) setCurrentScreen("pipeline");
                        else setLaunchError(d.error || "Launch failed");
                    })
                    .catch((e) => {
                        setLaunchLoading(false);
                        setLaunchError(String(e));
                    });
            };

            const appCtxValue = {
                navigateToPreflightWithSeed,
                setSeedRoadmap,
                setRoadmapSeedLocked,
                setCurrentScreen,
            };

            return (
                <AppCtx.Provider value={appCtxValue}>
                    <div className="flex h-screen overflow-hidden bg-[#0d0f12]">
                        <Sidebar currentScreen={currentScreen} onNavigate={handleNavigate} />
                        <div className="flex-1 flex flex-col overflow-hidden">
                            {currentScreen === "pipeline" && <PipelineScreen />}
                            {currentScreen === "preflight" && (
                                <PreflightScreen
                                    seedRoadmap={seedRoadmap}
                                    repoPath={repoPath}
                                    repoPathLocked={repoPathLocked}
                                    roadmapSeed={roadmapSeed}
                                    roadmapSeedLocked={roadmapSeedLocked}
                                    onRepoPathChange={setRepoPath}
                                    onRepoPathLockToggle={() => setRepoPathLocked(false)}
                                    onRoadmapSeedChange={setRoadmapSeed}
                                    onRoadmapSeedLockToggle={() => setRoadmapSeedLocked(false)}
                                    onBack={() => setCurrentScreen("ideas")}
                                    repoPathError={repoPathError}
                                    roadmapSeedError={roadmapSeedError}
                                    onRepoPathConfirm={onRepoPathConfirm}
                                    onRoadmapSeedConfirm={onRoadmapSeedConfirm}
                                    onRunPreflight={onRunPreflight}
                                    preflightChecks={preflightChecks}
                                    onLaunch={onLaunch}
                                    launchError={launchError}
                                    launchDisabled={launchDisabled}
                                />
                            )}
                            {currentScreen === "ideas" && <IdeasScreen />}
                        </div>
                    </div>
                </AppCtx.Provider>
            );
        }

        ReactDOM.createRoot(document.getElementById("app-root")).render(<App />);
    </script>
</body>
</html>
