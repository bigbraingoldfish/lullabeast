# AutoDev environment (install.sh writes .env on first install; copy this file as a template).
# Source before running:  source .env

# OpenClaw data root (workspaces, openclaw.json, pipeline-project symlink target).
# Default is ~/.openclaw. For Docker or a bind-mounted data dir, set this to the host path
# that contains workspace-planner, openclaw.json, etc. (must match ui/config.json openclaw_root).
AUTODEV_ROOT=~/.openclaw

# This repository root (contains autodev/pipeline/orchestrator.py).
AUTODEV_REPO_PATH=/path/to/autodev-ui

# Bearer token for UI → OpenClaw POST /hooks/agent (overrides hooks_token in ui/config.json).
# AUTODEV_HOOKS_TOKEN=your-hooks-token-from-openclaw.json

# HTTP origin of llama-server (scheme + host + port, no path). Used when orchestrator/heartbeat
# need a fallback and models.providers.llama-local.baseUrl is unset.
# AUTODEV_LLAMA_BASE=http://127.0.0.1:11434

# Phase audit snapshots: absolute path or ~. Unset → $AUTODEV_ROOT/pipeline-audit. Set to empty → disable.
# AUTODEV_AUDIT_ARCHIVE_DIR=
